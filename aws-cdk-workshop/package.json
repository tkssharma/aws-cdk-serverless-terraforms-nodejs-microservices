{
  "name": "aws-cdk-workshop",
  "version": "1.0.0",
  "license": "MIT",
  "scripts": {
    "build": "nx build --project @aws-cdk/cdk-common",
    "check-engines": "pnpm run check-engines -r",
    "prebuild": "npm run check-engines",
    "prepare": "husky",
    "prettier": "./node_modules/.bin/prettier --check \"**/*.{js,json,ts,yml,yaml}\"",
    "prettier:write": "./node_modules/.bin/prettier --write \"**/*.{js,json,ts,yml,yaml}\""
  },
  "private": true,
  "engines": {
    "node": ">=20.0.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.6.0",
    "@commitlint/config-conventional": "^19.6.0",
    "commitizen": "^4.3.1",
    "conventional-changelog-cli": "^5.0.0",
    "cz-conventional-changelog": "^3.3.0",
    "eslint": "^9.16.0",
    "husky": "^9.1.7",
    "nx": "20.3.0",
    "prettier": "^3.4.2",
    "rimraf": "^6.0.1"
  },
  "workspaces": [
    "packages/*"
  ],
  "config": {
    "commitizen": {
      "path": "./node_modules/cz-conventional-changelog"
    }
  }
}
